# ============================================================================
# Goose Railway Deployment Environment Configuration
# ============================================================================
# Copy this file to Railway dashboard and set actual values for your deployment
# This template includes ALL supported AI providers with fallback strategy
# ============================================================================

# ============================================================================
# PRIMARY AI PROVIDERS (Choose at least one)
# ============================================================================

# OpenAI (GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic (Claude 3.5 Sonnet, etc.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-key-here

# OpenRouter (Multi-model provider)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# FALLBACK AI PROVIDERS (Optional - for redundancy)
# ============================================================================

# Mistral AI
MISTRAL_API_KEY=your-key-here

# Groq (Fast inference)
GROQ_API_KEY=gsk-your-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-key-here

# Xai (X.com AI)
XAI_API_KEY=your-key-here

# ============================================================================
# EXTERNAL TOOLS & SERVICES
# ============================================================================

# Telegram Bot (optional - for notifications/integration)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Tavily Search (AI-powered search)
TAVILY_API_KEY=your-key-here

# Firecrawl (Web scraping)
FIRECRAWL_API_KEY=your-key-here

# ElevenLabs (Text-to-speech)
ELEVENLABS_API_KEY=your-key-here

# ============================================================================
# SEARCH ENGINES
# ============================================================================

# Google Search API
GOOGLE_SEARCH_API_KEY=your-key-here
GOOGLE_SEARCH_ENGINE_ID=your-engine-id-here

# Exa Search (AI-focused)
EXA_API_KEY=your-key-here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=3000
GOOSE_ADDR=0.0.0.0
RUST_LOG=info,goose=debug
ENVIRONMENT=production

# ============================================================================
# STORAGE & CONFIG
# ============================================================================

GOOSE_CONFIG_HOME=/app/config
GOOSE_DATA_HOME=/app/data
GOOSE_CACHE_DIR=/app/cache

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================

# Default language model
GOOSE_DEFAULT_MODEL=gpt-4

# Enable experimental features
GOOSE_EXPERIMENTAL_FEATURES=false

# Request timeout (seconds)
GOOSE_REQUEST_TIMEOUT=300

# Max concurrent requests
GOOSE_MAX_CONCURRENT_REQUESTS=5

# Enable verbose logging
GOOSE_VERBOSE_LOGGING=false

# ============================================================================
# PROVIDER FALLBACK STRATEGY (Optional)
# ============================================================================
# Format: PROVIDER_NAME:PRIORITY:TIMEOUT_SECONDS
# Priority: 1=highest, higher number=lower priority
# Example order: OpenAI (1) > Anthropic (2) > OpenRouter (3)

GOOSE_PROVIDER_FALLBACK_ENABLED=true
GOOSE_PROVIDER_TIMEOUT=30

# ============================================================================
# NOTES
# ============================================================================
# 1. Replace all "your-key-here" values with actual API keys
# 2. At least ONE primary AI provider is required
# 3. Fallback providers are optional but recommended for reliability
# 4. Keep API keys secure - never commit to version control
# 5. Use Railway's secret management for sensitive data
# 6. Test in staging before deploying to production
