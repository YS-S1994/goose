{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfile": "./Dockerfile",
    "buildArgs": {
      "RUST_VERSION": "1.94.1"
    },
    "context": "."
  },
  "deploy": {
    "startCommand": "goose",
    "numReplicas": 1,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "memory": "1Gi",
    "cpu": 1
  }
}
