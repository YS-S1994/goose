# ============================================================================
# Goose Railway Environment Configuration
# ============================================================================

# ============================================================================
# مفاتيح API للمزودات (اختر واحداً أو أكثر)
# ============================================================================

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-key-here

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================================================
# إعدادات الخادم
# ============================================================================

PORT=3000
GOOSE_ADDR=0.0.0.0
RUST_LOG=info,goose=debug

# ============================================================================
# متغيرات اختيارية
# ============================================================================

# مسار التخزين المؤقت (يتم حفظه تلقائياً في /root/.config/goose)
# GOOSE_CONFIG_HOME=/root/.config/goose

# لغة النموذج الافتراضية
# GOOSE_DEFAULT_LANGUAGE=en
