# ============================================================================
# Goose Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual API keys
# This template supports all available AI providers and services
# ============================================================================

# ============================================================================
# PRIMARY AI PROVIDERS (Choose at least one - required for operation)
# ============================================================================

# OpenAI (GPT-4, GPT-4o, etc.) - Recommended
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-key-here

# OpenRouter (Multi-model provider - gives access to many models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Azure OpenAI (if using Azure deployment)
# AZURE_OPENAI_API_KEY=your-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================================================
# FALLBACK AI PROVIDERS (Optional - for redundancy/cost optimization)
# ============================================================================
# These are used if primary providers fail or hit rate limits
# Leaving blank will skip this provider

# Mistral AI (7B, 8x7B models)
# MISTRAL_API_KEY=your-key-here

# Groq (Fast inference, free tier available)
# GROQ_API_KEY=gsk-your-key-here

# DeepSeek (Chinese LLM provider)
# DEEPSEEK_API_KEY=your-key-here

# Xai (X.com AI models)
# XAI_API_KEY=your-key-here

# ============================================================================
# EXTERNAL TOOLS & INTEGRATIONS
# ============================================================================

# Telegram Bot Integration (optional)
# Used for notifications, status updates, or bot commands
# TELEGRAM_BOT_TOKEN=123456:ABCdef-your-token-here

# Tavily Search API (AI-powered web search)
# TAVILY_API_KEY=your-key-here

# Firecrawl (Advanced web scraping and LLM-ready conversion)
# FIRECRAWL_API_KEY=your-key-here

# ElevenLabs (Text-to-speech)
# ELEVENLABS_API_KEY=your-key-here

# ============================================================================
# SEARCH ENGINES
# ============================================================================

# Google Custom Search Engine
# GOOGLE_SEARCH_API_KEY=your-key-here
# GOOGLE_SEARCH_ENGINE_ID=your-engine-id-here

# Exa Search (AI-optimized search)
# EXA_API_KEY=your-key-here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port to run on
PORT=3000

# Binding address
GOOSE_ADDR=0.0.0.0

# Logging level
RUST_LOG=info,goose=debug

# ============================================================================
# STORAGE & PERSISTENCE
# ============================================================================

# Configuration home directory (stores settings, preferences)
# Default: ~/.config/goose or %APPDATA%\goose on Windows
# GOOSE_CONFIG_HOME=/root/.config/goose

# Data directory (stores models, caches, persistent data)
# Default: ~/.local/share/goose or %LOCALAPPDATA%\goose on Windows
# GOOSE_DATA_HOME=/root/.local/share/goose

# Cache directory
# GOOSE_CACHE_DIR=/root/.cache/goose

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Default model to use (if multiple providers available)
# Examples: gpt-4, claude-3-5-sonnet, gemini-2.0-flash
# GOOSE_DEFAULT_MODEL=gpt-4

# Default language for model output
# GOOSE_DEFAULT_LANGUAGE=en

# Request timeout in seconds
# GOOSE_REQUEST_TIMEOUT=300

# Maximum concurrent requests
# GOOSE_MAX_CONCURRENT_REQUESTS=5

# Enable experimental features
# GOOSE_EXPERIMENTAL_FEATURES=false

# Verbose logging for debugging
# GOOSE_VERBOSE_LOGGING=false

# ============================================================================
# PROVIDER FALLBACK STRATEGY
# ============================================================================

# Enable automatic provider fallback
# GOOSE_PROVIDER_FALLBACK_ENABLED=true

# Timeout for provider requests (seconds)
# GOOSE_PROVIDER_TIMEOUT=30

# ============================================================================
# SECURITY & MONITORING
# ============================================================================

# Environment (development, staging, production)
# Defaults to development if not set
# ENVIRONMENT=production

# Rate limiting per provider (requests per minute)
# GOOSE_RATE_LIMIT=100

# Enable telemetry/analytics (optional)
# GOOSE_TELEMETRY_ENABLED=false

# ============================================================================
# DEPLOYMENT-SPECIFIC (Railway, Docker, etc.)
# ============================================================================

# For Railway deployments, use /app paths:
# GOOSE_CONFIG_HOME=/app/config
# GOOSE_DATA_HOME=/app/data

# For Docker deployments:
# GOOSE_CONFIG_HOME=/home/goose/.config/goose
# GOOSE_DATA_HOME=/home/goose/.local/share/goose

# ============================================================================
# NOTES
# ============================================================================
# 1. Replace all "your-key-here" values with actual API keys
# 2. At least ONE primary provider is required
# 3. Keep this file secure - never commit to version control
# 4. Use .env.local or environment variables in production
# 5. For Railway/Docker: set variables in the platform dashboard
# 6. Test configuration locally before deploying
# 7. Fallback providers improve reliability but may increase costs
